{
  "name": "dsh-app-row-brand",
  "version": "0.3.1",
  "type": "module",
  "description": "Custom text and image in the desktop window title bar, with rotation, fonts, shimmer and a Settings page.",
  "license": "MIT",
  "author": "CHNAQW",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "titlebar",
    "brand",
    "ui"
  ],
  "homepage": "https://github.com/CHNAQW/dsh-app-row-brand#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHNAQW/dsh-app-row-brand.git"
  },
  "bugs": {
    "url": "https://github.com/CHNAQW/dsh-app-row-brand/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
